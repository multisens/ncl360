---
// Starlight footer followed by the institution and laboratory logos.
import { Image } from 'astro:assets';
import Default from '@astrojs/starlight/components/Footer.astro';
import ufcirjColor from '../assets/UFCIRJcolorida.png';
import ufcirjWhite from '../assets/UFCIRJbranco.png';
import multisens from '../assets/multisens.png';

const UFCIRJ_URL = 'https://cefet-rj.br';
const MULTISENS_URL = 'https://multisens.com.br';

// Twice the displayed height of 2.5rem, for high-density screens.
const LOGO_HEIGHT = 80;
---

<Default><slot /></Default>
<div class="ncl360-footer">
    <div class="ncl360-footer-logos">
        <a href={UFCIRJ_URL}>
            <Image
                class="ncl360-logo ncl360-logo-light"
                src={ufcirjColor}
                height={LOGO_HEIGHT}
                alt="UFCIRJ — Universidade Federal de Ciência e Inovação do Rio de Janeiro"
            />
            <Image
                class="ncl360-logo ncl360-logo-dark"
                src={ufcirjWhite}
                height={LOGO_HEIGHT}
                alt="UFCIRJ — Universidade Federal de Ciência e Inovação do Rio de Janeiro"
            />
        </a>
        <a href={MULTISENS_URL}>
            <Image
                class="ncl360-logo"
                src={multisens}
                height={LOGO_HEIGHT}
                alt="Laboratório MultiSenS"
            />
        </a>
    </div>
    <p>UFCIRJ - Laboratório MultiSenS - NCL360</p>
</div>
